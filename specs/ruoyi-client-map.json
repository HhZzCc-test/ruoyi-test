{
  "_说明": [
    "人工维护的「接口 → RuoyiApiClient 方法」映射表，供 aitest scaffold --client-map 使用。",
    "这里只映射客户端真实封装过的方法；没映射到的接口生成的仍是骨架 + TODO（不去猜方法名）。",
    "写法：args 两边同名；path 支持 {\"客户端关键字\": \"用例字段名\"} 用于名字不一致的情况；",
    "params: true 表示把剩余字段作为 query 参数整体传入。",
    "pre 里可以写运行时前置代码；参数值写成 @变量名 表示该参数运行时取，",
    "不写死 AI 用例里的数据（典型场景：登录验证码必须实时从 Redis 取）。"
  ],
  "GET /captchaImage": {"method": "get_captcha"},
  "POST /login": {"method": "login",
                  "pre": ["_code, _uuid = self.get_captcha_code_and_uuid()"],
                  "args": {"username": "username", "password": "password",
                           "code": "@_code", "uuid": "@_uuid"}},
  "GET /getInfo": {"method": "get_info"},
  "GET /getRouters": {"method": "get_routers"},
  "GET /system/user/list": {"method": "get_user_list", "params": true},
  "GET /system/user/{userId}": {"method": "get_user_by_id",
                                "path": {"user_id": "userId"}},
  "GET /system/role/list": {"method": "get_role_list", "params": true},
  "GET /system/menu/list": {"method": "get_menu_list", "params": true},
  "GET /system/dept/list": {"method": "get_dept_list", "params": true},
  "GET /system/post/list": {"method": "get_post_list", "params": true},
  "GET /system/config/list": {"method": "get_config_list", "params": true},
  "GET /system/notice/list": {"method": "get_notice_list", "params": true},
  "GET /monitor/job/list": {"method": "get_job_list", "params": true},
  "GET /monitor/job/{jobId}": {"method": "get_job_by_id",
                               "path": {"job_id": "jobId"}},
  "GET /monitor/jobLog/list": {"method": "get_job_log_list", "params": true},
  "GET /monitor/online/list": {"method": "get_online_list", "params": true},
  "GET /monitor/operlog/list": {"method": "get_operlog_list", "params": true},
  "GET /monitor/logininfor/list": {"method": "get_logininfor_list", "params": true},
  "GET /monitor/server": {"method": "get_server_info"},
  "GET /monitor/cache": {"method": "get_cache_info"},
  "GET /monitor/cache/getNames": {"method": "get_cache_names"}
}
